# Optional. Free key from https://www.themoviedb.org/settings/api
# Enables the stylised anime title logos in the home hero.
NEXT_PUBLIC_TMDB_KEY=

# Required for streaming. Address of your running Anivexa API
# (https://github.com/walterwhite-69/Anivexa-API), without a trailing slash.
ANIVEXA_API_URL=
# Optional. Providers to use, in priority order. Default: anikoto,aniwaves,animegg
ANIVEXA_PROVIDERS=
# Optional. Long random string used to sign stream links.
STREAM_PROXY_SECRET=

# Optional but recommended: Upstash Redis cache (Vercel Storage > Upstash Redis adds these).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: server-side TMDB key (NEXT_PUBLIC_TMDB_KEY also works).
TMDB_KEY=

# Supabase (accounts + database). Defaults to the AniBiar project if not set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
